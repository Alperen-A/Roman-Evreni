<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Roman_evreni_mobil.Not_detay_page"
             BackgroundColor="#0a0a0a">

    <Grid RowDefinitions="Auto, Auto, *">
       <Grid RowDefinitions="Auto, Auto, *">
    <Image Grid.RowSpan="3" Source="notlar_ici_bg.jpeg" Aspect="AspectFill" Opacity="0.4" />
    
            <Label Text="← Geri" TextColor="#f5f5f5" FontSize="16" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="On_geri_clicked" />
                </Label.GestureRecognizers>
            </Label>
            <Label x:Name="Not_baslik_label" Grid.Column="1" Text="" FontSize="20" FontAttributes="Bold" TextColor="#f5f5f5" HorizontalOptions="Center" VerticalOptions="Center" FontFamily="Serif" />
            <Label Grid.Column="2" Text="Kaydet" TextColor="#f5f5f5" FontSize="16" FontAttributes="Bold" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="On_kaydet_clicked" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <Label x:Name="Kelime_sayaci" Grid.Row="1" TextColor="#525252" FontSize="12" Padding="20,0,20,10" />

        <ScrollView Grid.Row="2">
            <Editor x:Name="Editor_icerik"
                    Placeholder="Notunu yaz..."
                    PlaceholderColor="#525252"
                    TextColor="#f5f5f5"
                    BackgroundColor="Transparent"
                    FontSize="16"
                    FontFamily="Serif"
                    AutoSize="TextChanges"
                    Margin="20,0,20,40"
                    TextChanged="On_metin_degisti" />
        </ScrollView>
    </Grid>
</ContentPage>