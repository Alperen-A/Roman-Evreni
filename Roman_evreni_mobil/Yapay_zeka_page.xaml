<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Roman_evreni_mobil.Yapay_zeka_page"
             BackgroundColor="#0a0a0a">

    <Grid x:Name="Ana_kutu" Opacity="0" RowDefinitions="Auto, Auto, *, Auto">

        <Image Grid.RowSpan="4" Source="yapay_zeka_bg.jpg" Aspect="AspectFill" Opacity="0.4" />

        <!-- Üst bar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="20,40,20,20">
            <Label Text="← Geri" TextColor="#f5f5f5" FontSize="16" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="On_geri_clicked" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="Asistan" FontSize="26" FontAttributes="Bold" TextColor="#f5f5f5" HorizontalOptions="End" VerticalOptions="Center" FontFamily="Serif" />
        </Grid>

        <!-- Mod seçimi -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *" Padding="20,0,20,15">
            <Border x:Name="Analiz_mod_border" Grid.Column="0" BackgroundColor="#1a1a1a" StrokeShape="RoundRectangle" Padding="10,8" Margin="0,0,5,0">
                <Label x:Name="Analiz_mod_label" Text="🔍 Analiz" TextColor="#f5f5f5" FontSize="14" HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="On_analiz_mod_clicked" />
                    </Label.GestureRecognizers>
                </Label>
            </Border>
            <Border x:Name="Yaz_mod_border" Grid.Column="1" BackgroundColor="#1a1a1a" StrokeShape="RoundRectangle" Padding="10,8" Margin="5,0,0,0">
                <Label x:Name="Yaz_mod_label" Text="✍️ Roman Yaz" TextColor="#737373" FontSize="14" HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="On_yaz_mod_clicked" />
                    </Label.GestureRecognizers>
                </Label>
            </Border>
        </Grid>

        <!-- Sohbet alanı -->
        <ScrollView Grid.Row="2" x:Name="Sohbet_scroll">
            <VerticalStackLayout x:Name="Sohbet_kutusu" Spacing="25" Padding="20,10,20,20">
               <Label Text="Evrenin hakkında tavsiye isteyebilir veya ham roman notlarını yapıştırarak karakter ve mekan listelerini otomatik doldurmamı sağlayabilirsin." 
                      TextColor="#737373" FontSize="14" FontFamily="Serif" FontAttributes="Italic" 
                      HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,20,0,0" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Alt giriş -->
        <Grid Grid.Row="3" ColumnDefinitions="*, Auto" Padding="20,10,20,30">
            <Entry x:Name="Entry_soru" Placeholder="Yapay zekaya sor..." PlaceholderColor="#525252" 
                   TextColor="#f5f5f5" BackgroundColor="Transparent" 
                   FontSize="16" Margin="0,0,10,0" FontFamily="Serif" />
            <Label Grid.Column="1" Text="↑" FontSize="28" TextColor="#f5f5f5" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="On_sor_clicked" />
                </Label.GestureRecognizers>
            </Label>
            <BoxView HeightRequest="1" Color="#262626" VerticalOptions="End" Grid.ColumnSpan="2" Margin="0,0,0,-5" />
        </Grid>
    </Grid>
</ContentPage>