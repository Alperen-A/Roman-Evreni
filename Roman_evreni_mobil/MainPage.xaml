<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Roman_evreni_mobil.MainPage"
             BackgroundColor="#0a0a0a">

    <Grid RowDefinitions="Auto, *">
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="20,40,20,20">
            <Button Text="← Çıkış" Clicked="OnGeriClicked" BackgroundColor="Transparent" TextColor="#737373" FontSize="16" Padding="0" HorizontalOptions="Start" />
            <Label x:Name="Lbl_evrenadi" Grid.Column="1" Text="Evren" FontSize="26" FontAttributes="Bold" TextColor="#ededed" HorizontalOptions="End" VerticalOptions="Center" FontFamily="Serif" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" Padding="20,20,20,40" Spacing="25">
            <Button Text="Karakterler" Clicked="OnKarakterlerClicked" BackgroundColor="Transparent" TextColor="#a3a3a3" FontSize="22" FontFamily="Serif" HorizontalOptions="Start" Padding="0" />
            <BoxView HeightRequest="1" Color="#171717" />
            
            <Button Text="Mekanlar" Clicked="OnMekanlarClicked" BackgroundColor="Transparent" TextColor="#a3a3a3" FontSize="22" FontFamily="Serif" HorizontalOptions="Start" Padding="0" />
            <BoxView HeightRequest="1" Color="#171717" />
            
            <Button Text="Olay Örgüsü" Clicked="OnOlaylarClicked" BackgroundColor="Transparent" TextColor="#a3a3a3" FontSize="22" FontFamily="Serif" HorizontalOptions="Start" Padding="0" />
            <BoxView HeightRequest="1" Color="#171717" />

            <Button Text="Yapay Zeka Asistanı" Clicked="On_asistan_clicked" BackgroundColor="Transparent" TextColor="#a3a3a3" FontSize="22" FontFamily="Serif" HorizontalOptions="Start" Padding="0" />
            <BoxView HeightRequest="1" Color="#171717" />
            
        </VerticalStackLayout>
    </Grid>
</ContentPage>