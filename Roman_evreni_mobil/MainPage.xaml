<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Roman_evreni_mobil.Mainpage"
             BackgroundColor="#0a0a0a">
    <Grid x:Name="Ana_kutu" Opacity="0">
        <Image Source="giris_bg.jpg" Aspect="AspectFill" Opacity="0.4" />
      <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">

            <!-- Üst bar -->
          <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto, Auto, Auto" Padding="20,40,20,20">
    <Label Text="← Geri" TextColor="#f5f5f5" FontSize="16" VerticalOptions="Center">
        <Label.GestureRecognizers>
            <TapGestureRecognizer Tapped="On_geri_clicked" />
        </Label.GestureRecognizers>
    </Label>
    <Label x:Name="Evren_adi_label" Grid.Column="1" Text="Evren" FontSize="26" FontAttributes="Bold" FontFamily="Serif" TextColor="#f5f5f5" HorizontalOptions="Center" VerticalOptions="Center" />
    <Label Grid.Column="2" Text="★" FontSize="22" TextColor="#f5c518" VerticalOptions="Center" Padding="0,0,10,0">
        <Label.GestureRecognizers>
            <TapGestureRecognizer Tapped="On_favoriler_clicked" />
        </Label.GestureRecognizers>
    </Label>
    <Label Grid.Column="3" Text="⬇" FontSize="22" TextColor="#f5f5f5" VerticalOptions="Center" Padding="0,0,10,0">
        <Label.GestureRecognizers>
            <TapGestureRecognizer Tapped="On_yedekle_clicked" />
        </Label.GestureRecognizers>
    </Label>
    <Label Grid.Column="4" Text="⬆" FontSize="22" TextColor="#f5f5f5" VerticalOptions="Center">
        <Label.GestureRecognizers>
            <TapGestureRecognizer Tapped="On_geri_yukle_clicked" />
        </Label.GestureRecognizers>
    </Label>
</Grid>

        <!-- Alt bar - Yapay Zeka -->
<Grid Grid.Row="4" BackgroundColor="#111111" Padding="20,12">
    <Label Text="✨ Yapay Zeka Asistan" TextColor="#f5f5f5" FontSize="16" FontFamily="Serif" HorizontalOptions="Center">
        <Label.GestureRecognizers>
            <TapGestureRecognizer Tapped="On_asistan_clicked" />
        </Label.GestureRecognizers>
    </Label>
</Grid>

            <!-- Arama kutusu -->
            <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Padding="20,0,20,15">
                <Entry x:Name="Entry_arama" Placeholder="Evren içinde ara..." PlaceholderColor="#525252" TextColor="#f5f5f5" BackgroundColor="Transparent" FontSize="16" FontFamily="Serif" TextChanged="On_arama_degisti" />
                <Label Grid.Column="1" Text="🔍" FontSize="20" VerticalOptions="Center" Padding="10,0,0,0" />
                <BoxView HeightRequest="1" Color="#262626" VerticalOptions="End" Grid.ColumnSpan="2" />
            </Grid>

            <!-- Arama sonuçları -->
            <ScrollView Grid.Row="2" x:Name="Arama_scroll" IsVisible="False" MaximumHeightRequest="300">
                <VerticalStackLayout x:Name="Arama_sonuclari" Padding="20,5,20,10" Spacing="0" BackgroundColor="#111111" />
            </ScrollView>

            <!-- Ana menü -->
            <ScrollView Grid.Row="3">
                <VerticalStackLayout x:Name="Ana_menu" Padding="20,20,20,40" Spacing="25">
                  <Button x:Name="Roman_btn" Text="Romanlar" Clicked="On_romanlar_clicked" BackgroundColor="Transparent" TextColor="#f5f5f5" FontSize="22" HorizontalOptions="Start" />
<BoxView HeightRequest="1" Color="#262626" />

<Button x:Name="Karakter_btn" Text="Karakterler" Clicked="On_karakterler_clicked" BackgroundColor="Transparent" TextColor="#f5f5f5" FontSize="22" HorizontalOptions="Start" />
<BoxView HeightRequest="1" Color="#262626" />

<Button x:Name="Mekan_btn" Text="Mekanlar" Clicked="On_mekanlar_clicked" BackgroundColor="Transparent" TextColor="#f5f5f5" FontSize="22" HorizontalOptions="Start" />
<BoxView HeightRequest="1" Color="#262626" />

<Button x:Name="Olay_btn" Text="Olay orgusu" Clicked="On_olaylar_clicked" BackgroundColor="Transparent" TextColor="#f5f5f5" FontSize="22" HorizontalOptions="Start" />
<BoxView HeightRequest="1" Color="#262626" />

<Button x:Name="Not_btn" Text="Notlar" Clicked="On_notlar_clicked" BackgroundColor="Transparent" TextColor="#f5f5f5" FontSize="22" HorizontalOptions="Start" />
<BoxView HeightRequest="1" Color="#262626" />

                </VerticalStackLayout>
            </ScrollView>

        </Grid>
    </Grid>
</ContentPage>