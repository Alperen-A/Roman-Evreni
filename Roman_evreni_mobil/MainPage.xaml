<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Roman_evreni_mobil.MainPage"
             BackgroundColor="#180d31">

    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="30" VerticalOptions="Center">

            <Label Text="Roman evreni" FontSize="32" FontAttributes="Bold" TextColor="#ffffff" HorizontalOptions="Center" />

            <Label Text="Yonetim sistemine hos geldiniz" FontSize="18" TextColor="#dddddd" HorizontalOptions="Center" />

            <Button x:Name="BtnKarakterler" Text="1. Karakter yonetimi" Clicked="OnKarakterlerClicked" BackgroundColor="#ffff00" TextColor="#000000" CornerRadius="12" FontAttributes="Bold" HeightRequest="60" />

            <Button x:Name="BtnMekanlar" Text="2. Mekan yonetimi" Clicked="OnMekanlarClicked" BackgroundColor="#ffff00" TextColor="#000000" CornerRadius="12" FontAttributes="Bold" HeightRequest="60" />

            <Button x:Name="BtnOlaylar" Text="3. Olay yonetimi" Clicked="OnOlaylarClicked" BackgroundColor="#ffff00" TextColor="#000000" CornerRadius="12" FontAttributes="Bold" HeightRequest="60" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>