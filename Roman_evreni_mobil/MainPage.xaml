<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Roman_evreni_mobil.MainPage"
             BackgroundColor="#180d31">

    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="30" VerticalOptions="Center">

            <Label x:Name="Lbl_evrenadi" Text="Roman evreni" FontSize="32" FontAttributes="Bold" TextColor="#ffffff" HorizontalOptions="Center" />
            
            <Label Text="Yonetim sistemine hos geldiniz" FontSize="16" TextColor="#dddddd" HorizontalOptions="Center" Margin="0,0,0,20" />

            <Button x:Name="Btn_karakterler" Text="1. Karakter yonetimi" Clicked="OnKarakterlerClicked" BackgroundColor="#ffff00" TextColor="#000000" CornerRadius="25" FontAttributes="Bold" HeightRequest="55" WidthRequest="250" HorizontalOptions="Center" />

            <Button x:Name="Btn_mekanlar" Text="2. Mekan yonetimi" Clicked="OnMekanlarClicked" BackgroundColor="#ffff00" TextColor="#000000" CornerRadius="25" FontAttributes="Bold" HeightRequest="55" WidthRequest="250" HorizontalOptions="Center" />

            <Button x:Name="Btn_olaylar" Text="3. Olay yonetimi" Clicked="OnOlaylarClicked" BackgroundColor="#ffff00" TextColor="#000000" CornerRadius="25" FontAttributes="Bold" HeightRequest="55" WidthRequest="250" HorizontalOptions="Center" />

            <Button Text="Evren secimine don" Clicked="OnGeriClicked" BackgroundColor="#ff4444" TextColor="#ffffff" CornerRadius="25" FontAttributes="Bold" HeightRequest="50" WidthRequest="200" HorizontalOptions="Center" Margin="0,40,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>