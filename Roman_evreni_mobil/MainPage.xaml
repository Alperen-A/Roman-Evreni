<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Roman_evreni_mobil.Mainpage"
             BackgroundColor="#0a0a0a">

    <Grid>
        <Image Source="giris_bg.jpg" Aspect="AspectFill" Opacity="0.6" />

        <Grid RowDefinitions="Auto, *">
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="20,40,20,20">
                <Label Text="+ Kayit" TextColor="#737373" FontSize="16" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="On_kayit_clicked" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="1" Text="Evren" FontSize="26" FontAttributes="Bold" TextColor="#ededed" HorizontalOptions="End" />
            </Grid>

            <VerticalStackLayout Grid.Row="1" Padding="20,20,20,40" Spacing="25">
                <Button Text="Karakterler" Clicked="On_karakterler_clicked" BackgroundColor="Transparent" TextColor="#a3a3a3" FontSize="22" HorizontalOptions="Start" />
                <BoxView HeightRequest="1" Color="#171717" />

                <Button Text="Mekanlar" Clicked="On_mekanlar_clicked" BackgroundColor="Transparent" TextColor="#a3a3a3" FontSize="22" HorizontalOptions="Start" />
                <BoxView HeightRequest="1" Color="#171717" />

                <Button Text="Olay orgusu" Clicked="On_olaylar_clicked" BackgroundColor="Transparent" TextColor="#a3a3a3" FontSize="22" HorizontalOptions="Start" />
                <BoxView HeightRequest="1" Color="#171717" />

                <Button Text="Yapay zeka asistan" Clicked="On_asistan_clicked" BackgroundColor="Transparent" TextColor="#a3a3a3" FontSize="22" HorizontalOptions="Start" />
                <BoxView HeightRequest="1" Color="#171717" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>