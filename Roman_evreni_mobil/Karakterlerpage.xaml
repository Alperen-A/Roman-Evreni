<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Roman_evreni_mobil.Karakterlerpage"
             BackgroundColor="#180d31">

    <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">
        
        <Label Text="Karakter yonetimi" FontSize="28" FontAttributes="Bold" TextColor="#ffffff" HorizontalOptions="Center" />
        
        <Label Text="Burada romanindaki karakterleri listeleyecegiz." FontSize="16" TextColor="#dddddd" HorizontalOptions="Center" />

        <Button x:Name="BtnGeri" Text="Main menuye don" Clicked="OnGeriClicked" BackgroundColor="#ffff00" TextColor="#000000" CornerRadius="12" FontAttributes="Bold" HeightRequest="50" Margin="0,50,0,0" />
        
    </VerticalStackLayout>
</ContentPage>