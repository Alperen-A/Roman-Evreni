<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Roman_evreni_mobil.Karakter_detay_page"
             BackgroundColor="#0a0a0a">

    <Grid x:Name="Ana_kutu" Opacity="0" RowDefinitions="Auto, *">
        <Image Grid.RowSpan="2" Source="karakter_detay_bg.jpg" Aspect="AspectFill" Opacity="0.4" />
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto, Auto" Padding="20,40,20,20">
            <Label Grid.Column="0" Text="← Geri" TextColor="#f5f5f5" FontSize="16" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="On_geri_clicked" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="Karakter" FontSize="20" FontAttributes="Bold" TextColor="#f5f5f5" HorizontalOptions="Center" VerticalOptions="Center" FontFamily="Serif" />
            <Label x:Name="Karakter_favori_label" Grid.Column="2" Text="☆" FontSize="22" TextColor="#737373" VerticalOptions="Center" Padding="0,0,15,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="On_favori_clicked" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="3" Text="Kaydet" TextColor="#f5f5f5" FontSize="16" FontAttributes="Bold" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="On_kaydet_clicked" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="25" Padding="20,10,20,40">
                <VerticalStackLayout Spacing="5">
                    <Label Text="İsim" TextColor="#a3a3a3" FontSize="12" />
                    <Entry x:Name="Entry_ad" BackgroundColor="Transparent" TextColor="#f5f5f5" IsEnabled="True" FontSize="18" FontFamily="Serif" />
                    <BoxView HeightRequest="1" Color="#171717" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="5">
                    <Label Text="Dış görünüş" TextColor="#a3a3a3" FontSize="12" />
                    <Entry x:Name="Entry_dis_gorunus" Placeholder="Fiziksel özellikleri..." PlaceholderColor="#737373" BackgroundColor="Transparent" TextColor="#f5f5f5" FontSize="18" FontFamily="Serif" />
                    <BoxView HeightRequest="1" Color="#171717" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="5">
                    <Label Text="Hikaye" TextColor="#a3a3a3" FontSize="12" />
                    <Editor x:Name="Editor_hikaye" Placeholder="Geçmişi ve amacı..." PlaceholderColor="#737373" BackgroundColor="Transparent" TextColor="#f5f5f5" FontSize="16" FontFamily="Serif" AutoSize="TextChanges" />
                    <BoxView HeightRequest="1" Color="#171717" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>