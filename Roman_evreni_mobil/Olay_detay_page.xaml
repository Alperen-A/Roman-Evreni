<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Roman_evreni_mobil.Olay_detay_page"
             BackgroundColor="#0a0a0a">

    <Grid RowDefinitions="Auto, *">
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="20,40,20,20">
            <Label Grid.Column="0" Text="← Geri" TextColor="#737373" FontSize="16" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="On_geri_clicked" />
                </Label.GestureRecognizers>
            </Label>
            
            <Label Grid.Column="1" Text="Olay detay" FontSize="20" FontAttributes="Bold" TextColor="#ededed" HorizontalOptions="Center" VerticalOptions="Center" FontFamily="Serif" />
            
            <Label Grid.Column="2" Text="Kaydet" TextColor="#d4d4d4" FontSize="16" FontAttributes="Bold" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="On_kaydet_clicked" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="25" Padding="20,10,20,40">
                
                <VerticalStackLayout Spacing="5">
                    <Label Text="Olay adı" TextColor="#525252" FontSize="12" />
                    <Entry x:Name="Entry_ad" BackgroundColor="Transparent" TextColor="#a3a3a3" IsEnabled="False" FontSize="18" FontFamily="Serif" />
                    <BoxView HeightRequest="1" Color="#171717" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="İlgili mekanlar" TextColor="#525252" FontSize="12" />
                    <Entry x:Name="Entry_mekanlar" Placeholder="Hangi mekanlarda geçiyor..." PlaceholderColor="#262626" BackgroundColor="Transparent" TextColor="#d4d4d4" FontSize="18" FontFamily="Serif" />
                    <BoxView HeightRequest="1" Color="#171717" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="İlgili karakterler" TextColor="#525252" FontSize="12" />
                    <Entry x:Name="Entry_karakterler" Placeholder="Hangi karakterler var..." PlaceholderColor="#262626" BackgroundColor="Transparent" TextColor="#d4d4d4" FontSize="18" FontFamily="Serif" />
                    <BoxView HeightRequest="1" Color="#171717" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Açıklama" TextColor="#525252" FontSize="12" />
                    <Editor x:Name="Editor_aciklama" Placeholder="Olayın detayları..." PlaceholderColor="#262626" BackgroundColor="Transparent" TextColor="#d4d4d4" FontSize="16" FontFamily="Serif" AutoSize="TextChanges" />
                    <BoxView HeightRequest="1" Color="#171717" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>