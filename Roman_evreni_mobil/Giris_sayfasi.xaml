<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Roman_evreni_mobil.Giris_sayfasi"
             BackgroundColor="#0a0a0a">

    <Grid RowDefinitions="Auto, *">
        <Label Grid.Row="0" Text="Evrenler" FontSize="28" FontAttributes="Bold" TextColor="#ededed" Margin="20,40,20,20" FontFamily="Serif" />
        
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,10,20,40" Spacing="0" x:Name="Main_kutu" Opacity="0">
                
                <Grid ColumnDefinitions="*, Auto" Padding="0,10,0,20">
                    <Entry x:Name="Entry_yeni_evren" Placeholder="Yeni evren oluştur..." PlaceholderColor="#525252" TextColor="#d4d4d4" BackgroundColor="Transparent" FontSize="18" Margin="0,0,10,0" />
                    
                    <Label Grid.Column="1" Text="+" FontSize="32" TextColor="#d4d4d4" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="On_evren_olustur_clicked" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
                
                <BoxView HeightRequest="1" Color="#262626" Margin="0,0,0,20" />
                
                <VerticalStackLayout x:Name="Evrenler_listesi" Spacing="0" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>