<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Roman_evreni_mobil.Giris_sayfasi"
             BackgroundColor="#0a0a0a">

    <Grid x:Name="Main_kutu" Opacity="0">
        
        <Grid RowDefinitions="Auto, *">
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="20,40,20,20">
                <Entry x:Name="Entry_yeni_evren" 
                       Placeholder="Yeni bir evren yarat..." 
                       PlaceholderColor="#525252" 
                       TextColor="#d4d4d4" 
                       BackgroundColor="Transparent" />
                
                <Label Grid.Column="1" Text="+" FontSize="32" TextColor="#d4d4d4" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="On_evren_olustur_clicked" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout x:Name="Evrenler_listesi" Spacing="10" Padding="20,0,20,40" />
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>