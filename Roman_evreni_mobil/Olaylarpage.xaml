<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Roman_evreni_mobil.Olaylarpage"
             BackgroundColor="#0a0a0a">

    <Grid>
        <Image Source="olaylar_bg.png" Aspect="AspectFill" Opacity="0.3" />

        <Grid RowDefinitions="Auto, Auto, *">
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="20,40,20,20">
                <Label Text="← Geri" TextColor="#737373" FontSize="16" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="On_geri_clicked" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="1" Text="Olaylar" FontSize="26" FontAttributes="Bold" TextColor="#ededed" HorizontalOptions="End" />
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Padding="20,10,20,30">
                <Entry x:Name="Entry_olay_adi" 
                       Placeholder="Yeni bir olay yaz..." 
                       PlaceholderColor="#525252" 
                       TextColor="#d4d4d4" 
                       BackgroundColor="Transparent" />
                <Label Grid.Column="1" Text="+" FontSize="32" TextColor="#d4d4d4" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="On_olay_ekle_clicked" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <ScrollView Grid.Row="2">
                <VerticalStackLayout x:Name="Olay_listesi" Spacing="10" Padding="20,0,20,40" />
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>