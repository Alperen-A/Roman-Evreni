<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Roman_evreni_mobil.Notlarpage"
             BackgroundColor="#0a0a0a">

    <Grid>
        <Image Source="giris_bg.jpg" Aspect="AspectFill" Opacity="0.4" />

        <Grid RowDefinitions="Auto, Auto, *">
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="20,40,20,20">
                <Label Text="← Geri" TextColor="#f5f5f5" FontSize="16" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="On_geri_clicked" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="1" Text="Notlar" FontSize="26" FontAttributes="Bold" TextColor="#f5f5f5" HorizontalOptions="End" VerticalOptions="Center" FontFamily="Serif" />
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Padding="20,10,20,30">
                <Entry x:Name="Entry_not_adi" Placeholder="Yeni not başlığı..." PlaceholderColor="#737373" TextColor="#f5f5f5" BackgroundColor="Transparent" FontSize="18" Margin="0,0,10,0" />
                <Label Grid.Column="1" Text="+" FontSize="32" TextColor="#f5f5f5" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="On_not_ekle_clicked" />
                    </Label.GestureRecognizers>
                </Label>
                <BoxView HeightRequest="1" Color="#262626" VerticalOptions="End" Grid.ColumnSpan="2" Margin="0,0,0,-5" />
            </Grid>

            <ScrollView Grid.Row="2">
                <VerticalStackLayout x:Name="Not_listesi" Spacing="0" Padding="20,0,20,40" />
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>