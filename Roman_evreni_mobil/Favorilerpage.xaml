<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Roman_evreni_mobil.Favorilerpage"
             BackgroundColor="#0a0a0a">

    <Grid x:Name="Ana_kutu" Opacity="0">
        <Image Source="giris_bg.jpg" Aspect="AspectFill" Opacity="0.4" />

        <Grid RowDefinitions="Auto, *">
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="20,40,20,20">
                <Label Text="← Geri" TextColor="#f5f5f5" FontSize="16" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="On_geri_clicked" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="1" Text="★ Favoriler" FontSize="26" FontAttributes="Bold" TextColor="#f5f5f5" HorizontalOptions="End" VerticalOptions="Center" FontFamily="Serif" />
            </Grid>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout x:Name="Favori_listesi" Padding="20,0,20,40" Spacing="0" />
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>